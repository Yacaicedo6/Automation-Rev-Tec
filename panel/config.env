# Un solo número que controla cuántas sesiones de "Ejecutar verificaciones"
# (Chrome + pantalla virtual + VNC) pueden correr al mismo tiempo. El resto
# del panel (Preparar personas, Panorama general) no tiene límite porque no
# usa Chrome.
#
# Súbelo cuando tengas más RAM disponible o cambies a un servidor dedicado
# -- tanto panel/iniciar.sh como el backend leen este mismo número, así que
# no hay que tocar código en ningún lado.
MAX_SESIONES_PARALELAS=2
